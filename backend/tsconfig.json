{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "api/**/*", "*.json"],
  "exclude": [
    "node_modules",
    "dist",
    "src/bar-tests.ts",
    "src/embed-catalogue.ts",
    "src/test-search.ts",
    "src/fix-claude-redirect.ts",
    "src/fix-oauth-clients.ts",
    "src/seed.ts"
  ]
}
