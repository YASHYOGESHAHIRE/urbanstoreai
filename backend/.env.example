# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → Database → Connection string
# Use "Transaction" mode URL for DATABASE_URL (port 6543)
# Use "Session" mode URL for DIRECT_URL (port 5432)

DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?schema=public&pgbouncer=true&connect_timeout=30&pool_timeout=30&connection_limit=5"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.supabase.com:5432/postgres?schema=public"

# ─── Cookie ───────────────────────────────────────────────────────────────────
COOKIE_SECRET="generate-with: openssl rand -base64 32"

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
BACKEND_PUBLIC_URL="https://urbanstoreai-jz8i.vercel.app"

# ─── OAuth clients ────────────────────────────────────────────────────────────
CHATGPT_CLIENT_SECRET=""
CLAUDE_CLIENT_SECRET=""

# ─── Groq AI — https://console.groq.com (free) ───────────────────────────────
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ─── Razorpay — https://dashboard.razorpay.com ───────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
