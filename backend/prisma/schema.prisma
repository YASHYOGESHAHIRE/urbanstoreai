generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  isAdmin      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     Session[]
  oauthGrants  OAuthGrant[]
  carts        Cart[]
  orders       Order[]
  auditLogs    AuditLog[]

  @@map("users")
}

// ─── Session ──────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

// ─── OAuth ────────────────────────────────────────────────────────────────────

model OAuthClient {
  id           String          @id @default(cuid())
  name         String
  clientId     String          @unique
  clientSecret String
  redirectUris String[]
  scopes       String[]
  logoUrl      String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  grants       OAuthGrant[]
  authCodes    OAuthAuthCode[]

  @@map("oauth_clients")
}

model OAuthAuthCode {
  id          String      @id @default(cuid())
  code        String      @unique
  clientId    String
  userId      String
  scopes      String[]
  redirectUri String
  expiresAt   DateTime
  used        Boolean     @default(false)
  createdAt   DateTime    @default(now())
  client      OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([code])
  @@map("oauth_auth_codes")
}

model OAuthGrant {
  id           String      @id @default(cuid())
  accessToken  String      @unique
  refreshToken String?     @unique
  clientId     String
  userId       String
  scopes       String[]
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime    @default(now())
  client       OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accessToken])
  @@index([refreshToken])
  @@index([userId])
  @@map("oauth_grants")
}

// ─── Product catalogue ────────────────────────────────────────────────────────

model Product {
  id                    String           @id
  merchantId            String           @default("urban_store")
  name                  String
  brand                 String
  categoryId            String
  categoryName          String
  subcategoryId         String
  subcategoryName       String
  description           String
  imageAlt              String           @default("")
  useCases              String[]
  suitableFor           String[]
  notSuitableFor        String[]
  characteristics       Json             @default("{}")
  similarTo             String[]
  alternativeTo         String[]
  compatibleWith        String[]
  complements           String[]
  upgradeTo             String[]
  frequentlyBoughtWith  String[]
  requiresVariantSelect Boolean          @default(false)
  maxQtyPerOrder        Int              @default(5)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  variants              ProductVariant[]
  cartItems             CartItem[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@map("products")
}

model ProductVariant {
  id                 String     @id @default(cuid())
  sku                String     @unique
  productId          String
  attributes         Json
  priceAmount        Int
  priceCurrency      String     @default("INR")
  mrpAmount          Int
  mrpCurrency        String     @default("INR")
  availabilityStatus String
  quantityAvailable  Int        @default(0)
  lastUpdated        DateTime
  createdAt          DateTime   @default(now())
  product            Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]

  @@index([productId])
  @@index([availabilityStatus])
  @@map("product_variants")
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id           String     @id @default(cuid())
  userId       String
  agentGrantId String?                          // set when cart created by agent
  status       String     @default("active")   // active | checked_out | abandoned
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        CartItem[]
  checkouts    Checkout[]

  @@index([userId])
  @@index([status])
  @@map("carts")
}

model CartItem {
  id             String         @id @default(cuid())
  cartId         String
  productId      String
  variantSku     String
  quantity       Int            @default(1)
  priceSnapshot  Int                             // price at time of adding
  mrpSnapshot    Int
  addedAt        DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  variant        ProductVariant @relation(fields: [variantSku], references: [sku])

  @@unique([cartId, variantSku])
  @@index([cartId])
  @@map("cart_items")
}

// ─── Checkout ─────────────────────────────────────────────────────────────────

model Checkout {
  id               String    @id @default(cuid())
  cartId           String
  userId           String
  status           String    @default("pending")  // pending | confirmed | paid | failed | cancelled
  policyResult     Json      @default("{}")        // PolicyService output
  subtotal         Int       @default(0)
  razorpayOrderId  String?   @unique
  razorpayPaymentId String?
  razorpaySignature String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  cart             Cart      @relation(fields: [cartId], references: [id])
  order            Order?

  @@index([userId])
  @@index([status])
  @@map("checkouts")
}

// ─── Order ────────────────────────────────────────────────────────────────────

model Order {
  id          String    @id @default(cuid())
  checkoutId  String    @unique
  userId      String
  status      String    @default("placed")   // placed | processing | shipped | delivered | cancelled
  total       Int
  itemsJson   Json                            // snapshot of items at order time
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  checkout    Checkout  @relation(fields: [checkoutId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("orders")
}

// ─── Audit log ────────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  agentGrantId String?
  action       String                          // e.g. "cart.add", "checkout.confirm"
  payload      Json     @default("{}")
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Campaign (merchant marketing decisions) ─────────────────────────────────

model Campaign {
  id             String    @id @default(cuid())
  type           String                          // CLEARANCE | BUNDLE | URGENCY | SEASONAL | CROSS_SELL
  status         String    @default("pending")   // pending | approved | dismissed | active | expired
  productId      String?
  title          String
  trigger        String                          // human-readable trigger explanation
  proposedAction Json                            // { discountPct, bundleWith, label, ... }
  reasoning      Json                            // string[]
  projections    Json                            // { currentRevenue, projectedRevenue, netGain, confidence }
  risks          Json                            // string[]
  priority       Int       @default(1)
  approvedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@map("campaigns")
}

// ─── User behaviour tracking (personalization signals) ───────────────────────

model UserBehaviour {
  id         String   @id @default(cuid())
  userId     String?                             // null = anonymous
  sessionKey String                              // browser session id
  event      String                              // product_viewed | category_browsed | search_query | cart_add | chat_message
  productId  String?
  categoryId String?
  query      String?
  metadata   Json     @default("{}")             // extra context: time_spent, scroll_depth, etc.
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([event])
  @@index([productId])
  @@index([createdAt])
  @@map("user_behaviours")
}
